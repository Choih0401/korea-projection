[nemesis]
version=1.1
id=korea.projection
name=Korea Projection
type=service,application
package-version=1.4.1
short-desc="Enables wireless CarPlay on Korean Hyundai/Kia head units."
detailed-desc="순정 핫스폿이 켜지지 않는 한국 차에서 부팅할 때 순정 hostapd와 dnsmasq를 직접 실행합니다. 확인된 차: 기아 니로 하이브리드(DEPEHEV.KOR 260902). 다른 차에서는 대기만 합니다. HMG-API 무선 모드가 필요하고 wireless.projection은 필요 없습니다(지우면 기능 파일을 자동 복구). Launch: 상태 화면과 제보용 QR."
os="DEPEHEV.KOR.*.260902"
models="*_kr"
depends="!niro.carplay.hotspot"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
path=bin/status.sh
uid=root

[app.1]
component=korea.projection.app/.StatusActivity

[service.0]
name=ap
kind=sh
path=svc/hotspot.sh
uid=root
mode=restart
