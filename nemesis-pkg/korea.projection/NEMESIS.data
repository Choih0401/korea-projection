[nemesis]
version=1.1
id=korea.projection
name=Korea Projection
type=service,application
package-version=1.5.4
short-desc="Enables wireless CarPlay on Korean Hyundai/Kia head units."
detailed-desc="순정 핫스팟이 켜지지 않는 한국 차량에서 무선 카플레이 기능을 사용할 수 있습니다. HMG-API 무선 모드와 그 차의 MAP이 없으면 자동으로 넣습니다. 지원 확인이 되지 않은 차량은 Launch를 누른 후 QR코드를 통해 제보해 주세요. 개선에 많은 도움이 됩니다. 경고: Launch를 누른 후 약 5~10초간 기다려 주세요."
os="DEPEHEV.KOR.*.260902"
models="*_kr"
depends="!niro.carplay.hotspot"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
path=bin/status.sh
uid=root

[app.1]
component=korea.projection.app/.StatusActivity

[service.0]
name=ap
kind=sh
path=svc/hotspot.sh
uid=root
mode=restart
