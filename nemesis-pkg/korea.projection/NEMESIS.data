[nemesis]
version=1.1
id=korea.projection
name=Korea Projection
type=service,application
package-version=1.5.3
short-desc="Enables wireless CarPlay on Korean Hyundai/Kia head units."
detailed-desc="순정 핫스팟이 켜지지 않는 한국 차에서 무선 카플레이를 켭니다. HMG-API 무선 모드와 그 차의 지도가 없으면 자동으로 넣습니다. 확인된 차: 기아 니로 하이브리드. 그 밖의 한국 차는 차에서 지도를 만들어 확인한 뒤 시험으로 켭니다. 해외 차는 대기만 합니다. HMG-API가 필요합니다. Launch: 상태 화면과 제보용 QR."
os="DEPEHEV.KOR.*.260902"
models="*_kr"
depends="!niro.carplay.hotspot"
postinstall=scripts/post.sh
preuninstall=scripts/preun.sh

[app.0]
kind=sh
path=bin/status.sh
uid=root

[app.1]
component=korea.projection.app/.StatusActivity

[service.0]
name=ap
kind=sh
path=svc/hotspot.sh
uid=root
mode=restart
