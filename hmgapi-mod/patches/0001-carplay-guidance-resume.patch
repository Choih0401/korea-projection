--- /dev/null
+++ b/mods/wireless-carplay-aa/src/hmgapi/mods/wireless/dipo/GuidanceSession.java
@@ -0,0 +1,38 @@
+package hmgapi.mods.wireless.dipo;
+
+/** Serialized on turnsHandler. Unknown reads never mean disconnected; two stable
+ * observations prevent a transient handover from clearing a live/new route. */
+final class GuidanceSession {
+    static final long CONFIRM_MS = 2000L, START_GRACE_MS = 5000L;
+    private int generation;
+    private long activityAt, absentAt = -1L;
+    private int absentConnection = -1;
+
+    int generation() { return generation; }
+
+    void activity(long now) {
+        generation++;
+        activityAt = now;
+        forgetAbsence();
+    }
+
+    boolean shouldClear(int connection, int guiding, boolean androidAuto, long now) {
+        boolean absent = now - activityAt >= START_GRACE_MS
+                && (connection == 0 || (connection == 1 && guiding == 0));
+        if (androidAuto || !absent) {
+            forgetAbsence();
+            return false;
+        }
+        if (absentAt < 0L || absentConnection != connection || now < absentAt) {
+            absentAt = now;
+            absentConnection = connection;
+            return false;
+        }
+        return now - absentAt >= CONFIRM_MS;
+    }
+
+    private void forgetAbsence() {
+        absentAt = -1L;
+        absentConnection = -1;
+    }
+}
