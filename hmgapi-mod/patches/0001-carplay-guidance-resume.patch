+package hmgapi.mods.wireless;
+
+/** Do not trust a stale CarPlay TBT bit, or a single disconnected read during handover. */
+final class GuidanceGate {
+    private long absentAt = -1L;
+    synchronized boolean guiding(boolean aa, int connection, boolean cp, long now) {
+        if (aa || !cp || connection != 0) {
+            absentAt = -1L;
+            return aa || cp;
+        }
+        if (absentAt < 0L || now < absentAt) absentAt = now;
+        return now - absentAt < 2000L;
+    }
+}
